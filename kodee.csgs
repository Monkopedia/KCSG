val kodee by csg {
    val body = head or armRaised or armLowered or legLeft or legRight
    val carved = body - visorPocket - pupilLeft - pupilRight
    val faced = carved or eyeRingLeft or eyeRingRight or smile
    // Stand the relief upright, facing -Y.
    faced.transform { rotX(-90.0) }
}

export("kodee")
