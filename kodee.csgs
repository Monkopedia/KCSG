//
// Kodee — traced from the official SVG and extruded into relief.
// Built flat in the XY plane (+Z = front), then stood upright (rotX -90) so it
// faces -Y. Single-colour STL, so the face reads through depth: the visor is a
// recessed pocket, the eye-rings sit proud of it, the pupils are drilled deep,
// and the smile is a raised bar.

val bodyThickness = 24.0
val visorRecess = 11.0
val ringRaise = 8.0
val smileRaise = 5.0
val pocketFloor = bodyThickness - visorRecess

fun v(x: Double, y: Double) = Vector3d.xyz(x, y, 0.0)
fun ext(points: List<Vector3d>, depth: Double) =
    Extrude.points(Vector3d.xyz(0.0, 0.0, depth), points)

